NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_GEOCODING_URL=https://nominatim.openstreetmap.org/search
# Imagens de satélite (Esri World Imagery). Produção exige conta ArcGIS Location Platform.
NEXT_PUBLIC_SATELLITE_TILES_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# true: site publicado sem backend (ex.: so a landing na Vercel). O login vira um aviso
# de que o painel e mostrado na demonstracao ao vivo, e o site nao chama a API.
NEXT_PUBLIC_PANEL_OFFLINE=false
